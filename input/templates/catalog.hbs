<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - {{dataset}}</title>

    <!-- Канонические URL для предотвращения дублей -->
    <link rel="canonical" href="/catalog/{{dataset}}/page/{{pagination.currentPage}}">

    <!-- Open Graph для соцсетей -->
    <meta property="og:title" content="{{title}} - Страница {{pagination.currentPage}} из {{pagination.totalPages}}">

    <!-- JSON-LD для поисковых систем -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Каталог",
          "item": "/catalog/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{title}}",
          "item": "/catalog/{{dataset}}/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Страница {{pagination.currentPage}}",
          "item": "/catalog/{{dataset}}/page/{{pagination.currentPage}}"
        }
      ]
    }
    </script>

    {{!-- SEO-совместимые ссылки --}}
    {{#if pagination.hasPrev}}
        <link rel="prev" href="/catalog/{{dataset}}/page/{{pagination.prevPage}}">
    {{/if}}
    {{#if pagination.hasNext}}
        <link rel="next" href="/catalog/{{dataset}}/page/{{pagination.nextPage}}">
    {{/if}}

    {{!-- Даже текущая страница доступна --}}
    <meta name="robots" content="{{#ifCond pagination.currentPage '==' 1}}index, follow{{else}}noindex, follow{{/ifCond}}">

    <style>
        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 2rem;
            margin: 2rem 0;
        }
        .product-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 1.5rem;
            transition: transform 0.2s;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .pagination {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            margin: 2rem 0;
        }
        .pagination a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: 1px solid #0066cc;
            border-radius: 4px;
            color: #0066cc;
            text-decoration: none;
            font-weight: 500;
        }
        .pagination a.active {
            background-color: #0066cc;
            color: white;
        }
        .pagination a:hover:not(.active) {
            background-color: #f0f8ff;
        }
        .user-section {
            margin-top: 2rem;
            padding: 1.5rem;
            border: 1px dashed #0066cc;
            border-radius: 8px;
        }
    </style>
</head>
<body>
<header>
    <h1>{{title}}</h1>
</header>

<main>
    {{> ignition/pagination
            collection="products"
            perPage=2
            pageTemplate="catalog/page"
            layout=layout
            dataset=dataset
    }}

    {{!-- Реактивная user-секция: данные user, управляется внешним контроллером --}}
    {{> catalog/user user}}
</main>
</body>
</html>
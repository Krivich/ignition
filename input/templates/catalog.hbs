{{!-- ignition:paginate collection="products" perPage=2 csrTemplate="pagination" --}}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - {{itemName}}</title>

    {{!-- SEO-совместимые ссылки --}}
    {{#if pagination.hasPrev}}
        <link rel="prev" href="/catalog/{{itemName}}/page/{{pagination.prevPage}}">
    {{/if}}
    {{#if pagination.hasNext}}
        <link rel="next" href="/catalog/{{itemName}}/page/{{pagination.nextPage}}">
    {{/if}}

    <script src="https://cdn.jsdelivr.net/npm/handlebars@4.7.8/dist/handlebars.min.js"></script>
    <script src="/assets/ignition-pagination.js" defer></script>
    <style>
        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 2rem;
            margin: 2rem 0;
        }
        .product-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 1.5rem;
            transition: transform 0.2s;
        }
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .pagination {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            margin: 2rem 0;
        }
        .pagination a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border: 1px solid #0066cc;
            border-radius: 4px;
            color: #0066cc;
            text-decoration: none;
            font-weight: 500;
        }
        .pagination a.active {
            background-color: #0066cc;
            color: white;
        }
        .pagination a:hover:not(.active) {
            background-color: #f0f8ff;
        }
        .dynamic-content {
            margin-top: 2rem;
            padding: 1.5rem;
            border: 1px dashed #0066cc;
            border-radius: 8px;
            min-height: 100px;
        }
    </style>
</head>
<body>
<header>
    <h1>{{title}}</h1>
</header>

<main>
    <div
            id="catalog-container"
            data-ignition-pagination='{
                "collection": "products",
                "perPage": 2,
                "dataUrl": "/data/catalog/{{itemName}}.json",
                "templateUrl": "/templates/catalog/pagination.hbs",
                "currentPage": {{pagination.currentPage}},
                "basePath": "/catalog/{{itemName}}/page"
            }'
    >
        {{> catalog/pagination items=pagination.items pagination=pagination basePath="/catalog/{{itemName}}/page"}}
    </div>

    <div class="dynamic-content" id="dynamic-content">
        <p>Этот контент будет обновлен динамически через CSR после загрузки страницы.</p>
    </div>
</main>

<script id="dynamic-template" type="text/x-handlebars-template">
    <div class="user-section">
    {{#if user}}
        <h3>Привет, {{user.name}}!</h3>
        <p>У вас {{favorites.length}} {{declineWord favorites.length "товар" "товара" "товаров"}} в избранном.</p>
        <button id="toggle-favorite">Добавить в избранное</button>
    {{else}}
        <p>Войдите, чтобы управлять избранным</p>
        <button id="login-btn">Войти</button>
    {{/if}}
    </div>
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Динамическое обновление контента
        const dynamicContent = document.getElementById('dynamic-content');
        const templateSource = document.getElementById('dynamic-template').innerHTML;
        const template = Handlebars.compile(templateSource);

        // Регистрация хелпера для склонения слов
        Handlebars.registerHelper('declineWord', function(count, one, two, five) {
            count = Math.abs(count) % 100;
            const n1 = count % 10;
            if (count > 10 && count < 20) return five;
            if (n1 > 1 && n1 < 5) return two;
            if (n1 === 1) return one;
            return five;
        });

        const userData = {
            user: {
                name: 'Алексей',
                favorites: [123, 456]
            }
        };

        dynamicContent.innerHTML = template(userData);

        // Обработчики событий
        document.getElementById('toggle-favorite')?.addEventListener('click', () => {
            alert('Товар добавлен в избранное!');
        });

        document.getElementById('login-btn')?.addEventListener('click', () => {
            alert('Редирект на страницу входа...');
        });
    });
</script>
</body>
</html>
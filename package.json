{
  "name": "@kartotech/ignition",
  "version": "1.0.0",
  "description": "Atomic prerender engine for SSR/CSR content",
  "main": "engine/bin/cli.js",
  "type": "module",
  "scripts": {
    "build": "node engine/bin/cli.js build",
    "watch": "node engine/bin/cli.js watch",
    "example": "node engine/bin/cli.js --source input --output output",
    "serve": "npx http-server output/public -o",
    "dev": "npm-run-all --parallel watch serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node engine/perf/bench.js --scale 1",
    "bench:heavy": "node engine/perf/bench.js --scale 3"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "commander": "^14.0.2",
    "glob": "^13.0.6",
    "handlebars": "^4.7.9",
    "lodash.debounce": "^4.0.8",
    "p-queue": "^7.3.4",
    "p-retry": "^5.1.1",
    "picomatch": "^4.0.7",
    "winston": "^3.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "picomatch@2.3.1": "2.3.2"
  },
  "files": [
    "engine/bin/",
    "engine/config/",
    "engine/core/",
    "engine/utils/",
    "engine/logs/"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.62.1",
    "serve": "^14.2.5",
    "vitest": "^4.1.11"
  }
}

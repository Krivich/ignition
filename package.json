{
  "name": "@kartotekh/ignition",
  "version": "1.0.0",
  "description": "Atomic prerender engine for SSR/CSR content",
  "main": "bin/cli.js",
  "type": "module",
  "scripts": {
    "build": "node bin/cli.js build",
    "watch": "node bin/cli.js watch",
    "example": "node bin/cli.js --source input --output output",
    "serve": "npx http-server output/public -o",
    "dev": "npm-run-all --parallel watch serve"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "commander": "^14.0.2",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "lodash.debounce": "^4.0.8",
    "p-queue": "^7.3.4",
    "p-retry": "^5.1.1",
    "picomatch": "^3.0.1",
    "winston": "^3.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "core/",
    "utils/",
    "config/"
  ],
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "serve": "^14.2.5"
  }
}

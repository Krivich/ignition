<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест: Форма обратной связи</title>

    <script src="https://cdn.jsdelivr.net/npm/handlebars@4.7.8/dist/handlebars.min.js"></script>
    <script src="/assets/ignition-runtime.js"></script>
    <script src="/assets/templates.js"></script>
    <script>
        window.__IGNITION_INITIAL_DATA__ = {{{initialData}}};
    </script>
    <script>
    window.__IGNITION_PAGE_CONFIG__ = function(state, api) {
        api.blockOptions.renderers['form/contact'] = function(s) { return s; };

        function validate(s) {
            var errors = {};
            if (!s.form.fields.name) errors.name = 'Обязательное поле';
            if (!s.form.fields.email) errors.email = 'Обязательное поле';
            else if (s.form.fields.email.indexOf('@') === -1) errors.email = 'Некорректный email';
            if (!s.form.fields.message) errors.message = 'Обязательное поле';
            s.form.errors = errors;
            return Object.keys(errors).length === 0;
        }

        api.action('formSubmit', function(s) {
            var valid = validate(s);
            if (!valid) return;
            s.form.submitting = true;
            setTimeout(function() {
                s.form.submitting = false;
                s.form.submitted = true;
            }, 500);
        });

        api.action('formReset', function(s) {
            s.form.fields = { name: '', email: '', message: '' };
            s.form.errors = {};
            s.form.submitting = false;
            s.form.submitted = false;
        });

        state.subscribe('form.fields', function() { validate(state); });

        function updateButton() {
            var btn = document.querySelector('button[type="submit"]');
            if (!btn) return;
            var valid = Object.keys(state.form.errors).length === 0;
            var hasValues = state.form.fields.name && state.form.fields.email && state.form.fields.message;
            btn.disabled = !(valid && hasValues);
        }
        state.subscribe('form', function() { updateButton(); });
        setTimeout(updateButton, 0);

        document.addEventListener('focusout', function(e) {
            if (e.target.matches('[data-ignition-binding]')) {
                validate(state);
                updateButton();
            }
        });
    };
    </script>

    <style>
        body { font-family: sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.25rem; font-weight: bold; }
        .form-group input, .form-group textarea { width: 100%; padding: 0.5rem; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
        .form-group input:focus, .form-group textarea:focus { outline: none; border-color: #0066cc; }
        .error { color: #dc3545; font-size: 0.85em; margin-top: 0.25rem; }
        .spinner { padding: 2rem; text-align: center; color: #888; }
        .success { padding: 2rem; text-align: center; background: #d4edda; border-radius: 8px; }
        button[type="submit"] { padding: 0.75rem 1.5rem; background: #0066cc; color: white; border: none; border-radius: 4px; cursor: pointer; }
        button[type="submit"]:disabled { background: #ccc; cursor: not-allowed; }
        button[type="submit"]:hover:not(:disabled) { background: #0055aa; }
    </style>
</head>
<body>

    <h1>Форма обратной связи (тест реактивности)</h1>

    {{!-- ГРАБЛЬ #1: conditional rendering — три состояния --}}
    <div data-ignition-block="form/contact"
         data-ignition-depends="form">
    </div>

</body>
</html>

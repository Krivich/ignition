{{#if form.submitted}}
    <div class="success">
        <p>Спасибо! Мы ответим вам в ближайшее время.</p>
        <button id="resetBtn">Отправить ещё раз</button>
    </div>

{{else if form.submitting}}
    <div class="spinner">Отправка формы...</div>

{{else}}
    <form id="contactForm">
        <div class="form-group">
            <label for="name">Имя</label>
            <input type="text" id="name"
                   value="{{form.fields.name}}"
                   placeholder="Ваше имя">
            {{#if form.errors.name}}
                <div class="error">{{form.errors.name}}</div>
            {{/if}}
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email"
                   value="{{form.fields.email}}"
                   placeholder="your@email.com">
            {{#if form.errors.email}}
                <div class="error">{{form.errors.email}}</div>
            {{/if}}
        </div>

        <div class="form-group">
            <label for="message">Сообщение</label>
            <textarea id="message" rows="4"
                      placeholder="Ваше сообщение...">{{form.fields.message}}</textarea>
            {{#if form.errors.message}}
                <div class="error">{{form.errors.message}}</div>
            {{/if}}
        </div>

        <button type="submit">Отправить</button>
    </form>
{{/if}}

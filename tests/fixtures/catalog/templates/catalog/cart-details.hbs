{{#if items.length}}
    <div class="cart-details">
        <ul>
            {{#each items}}
                <li>
                    <span>{{name}} — {{price}} ₽</span>
                    <button class="remove-from-cart" data-id="{{id}}">
                        ✕
                    </button>
                </li>
            {{/each}}
        </ul>
    </div>
{{/if}}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Тест: Живой каталог</title>

    <style>
        body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; }
        .controls { display: flex; gap: 1rem; margin-bottom: 1rem; }
        .product-card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-bottom: 0.5rem; }
        .product-card .price { font-weight: bold; color: #0066cc; }
        .product-card .category { color: #888; font-size: 0.85em; }
        .cart-header { padding: 1rem; background: #f5f5f5; border-radius: 8px; margin-bottom: 1rem; }
        .cart-empty { color: #888; }
        .cart-count { font-weight: bold; }
        .cart-details ul { list-style: none; padding: 0; }
        .cart-details li { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #eee; }
        .empty { color: #888; padding: 2rem; text-align: center; }
        button { cursor: pointer; padding: 0.5rem 1rem; border: 1px solid #0066cc; background: white; color: #0066cc; border-radius: 4px; }
        button:hover { background: #f0f8ff; }
    </style>
</head>
<body>

    <h1>Каталог (тест реактивности)</h1>

    <div class="controls">
        <input type="search"
               id="searchInput"
               placeholder="Поиск товаров..."
               value="{{ui.searchQuery}}">

        <select id="categorySelect" value="{{ui.activeCategory}}">
            <option value="all">Все категории</option>
            <option value="electronics">Электроника</option>
            <option value="books">Книги</option>
        </select>
    </div>

    {{> catalog/product-list filteredProducts}}

    {{> catalog/cart-header cart}}

    {{> catalog/cart-details cart}}

</body>
</html>
